# Single environment file for the whole project.
# Copy to ./.env and mount into the container at /opt/agents44/.env
# (the container forces WORKSPACE_PATH, RUNTIME_DIR, LOG_DIR, and PSQL_HOST).
#
# LLM provider API keys (ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY,
# DASHSCOPE_API_KEY, or any other *_API_KEY) are NOT set here — put them in
# the UI under Settings (system_params table).

# Database
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_DB=agents44
PSQL_USER=agents44
PSQL_PASSWORD=agents44

# Flask
FLASK_SECRET_KEY=change-me-dev-secret
FRONTEND_URL=http://localhost

# Admin login (omit or leave DEV_LOGIN_EMAIL empty to disable)
# Backend reads these at runtime from the mounted .env. Production frontend
# does not embed the password — use the value from ~/.agents/<name>/.env
DEV_LOGIN_EMAIL=admin@catch44.co.il
DEV_LOGIN_PASSWORD=change-me-dev-password

# Google Sign-In (client ID only — token verified by backend via google-auth)
GOOGLE_CLIENT_ID=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@catch44.co.il
SMTP_APP_PASSWORD=
ADMIN_EMAIL=admin@catch44.co.il

# Provider-prefixed model ids (LiteLLM). Comma-separated allowlist.
SUPPORTED_MODELS=anthropic/claude-sonnet-4-6,anthropic/claude-haiku-4-5-20251001,gemini/gemini-2.5-flash,gemini/gemini-2.5-pro,dashscope/qwen-plus
DEFAULT_MODEL=gemini/gemini-2.5-flash

# Local LiteLLM gateway (bound to 127.0.0.1 inside the container)
LITELLM_PROXY_PORT=4000
LITELLM_MASTER_KEY=agents44-litellm-local

# Embedded MCP server (localhost only; Flask API uses port 5000)
MCP_PORT=5001

REACT_APP_API_URL=/api
REACT_APP_VERSION=
